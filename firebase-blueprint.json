      "title": "Buyer Auto-Delivery Entitlement",
      "description": "Deterministic purchase entitlement unlocking access to purchased deliveryVault unit(s).",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
