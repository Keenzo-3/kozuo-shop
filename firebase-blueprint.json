{
  "entities": {
    "StockItem": {
      "title": "Stock Item",
      "description": "A digital gaming account or file stock item listed for buyer purchase or inquiry.",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Display title of the stock item."
        },
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "description": "Short reference code for buyer inquiry and order tracking."
        },
        "category": {
          "type": "string",
          "enum": ["CODM ACCOUNT", "CODM&MLBB FILES"],
          "description": "Primary catalog category."
        },
        "accountGroup": {
          "type": "string",
          "enum": ["Clean", "Not Clean", "N/A"],
          "description": "Sub-group for CODM ACCOUNT items indicating bind cleanliness."
        },
        "fileType": {
          "type": "string",
          "maxLength": 60,
          "description": "Optional sub-label for CODM&MLBB FILES items."
        },
        "priceLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "description": "Formatted price string or inquiry label."
        },
        "pricePhp": {
          "type": "number",
          "description": "Numeric PHP unit price used for instant wallet balance purchases."
        },
        "status": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "description": "Stock status label (e.g. In Stock, Low Stock, Out of Stock, Restocking Soon, Sold, or custom)."
        },
        "stockCount": {
          "type": "number",
          "description": "Available quantity (1 for one-time-buy CODM ACCOUNT, stock-based count for CODM&MLBB FILES)."
        },
        "bindSummary": {
          "type": "string",
          "maxLength": 140,
          "description": "Short binding or compatibility summary."
        },
        "description": {
          "type": "string",
          "maxLength": 2000,
          "description": "Full item details and buyer notes."
        },
        "specifications": {
          "type": "array",
          "description": "Up to 12 key-value product specification entries ({ label, value })."
        },
        "highlights": {
          "type": "array",
          "description": "List of up to 12 concise bullet highlights."
        },
        "imageUrl": {
          "type": "string",
          "maxLength": 160000,
          "description": "Primary thumbnail path, HTTPS URL, or compressed image data URL."
        },
        "galleryImages": {
          "type": "array",
          "description": "Up to 7 detail photos for the item showcase gallery."
        },
        "featured": {
          "type": "boolean",
          "description": "Whether the item is highlighted at the top of the catalog."
        },
        "autoDelivery": {
          "type": "boolean",
          "description": "Whether instant automatic delivery from deliveryVault is configured for this product."
        },
        "nextDeliveryIndex": {
          "type": "number",
          "description": "Sequential cursor tracking the next available deliveryVault unit index."
        },
        "lastOrderId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Order ID of the latest verified balance purchase that decremented stock."
        },
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID of the store owner who created this item."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last update timestamp."
        }
      },
      "required": [
        "title",
        "code",
        "category",
        "accountGroup",
        "fileType",
        "priceLabel",
        "status",
        "stockCount",
        "bindSummary",
        "description",
        "highlights",
        "imageUrl",
        "galleryImages",
        "featured",
        "ownerId",
        "createdAt",
        "updatedAt"
      ]
    },
    "UserProfile": {
      "title": "User Profile & Wallet",
      "description": "Authenticated customer account with PHP wallet balance.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "minLength": 3,
          "maxLength": 120
        },
        "username": {
          "type": "string",
          "maxLength": 24,
          "description": "Normalized lowercase username for user:pass members."
        },
        "contactEmail": {
          "type": "string",
          "maxLength": 120,
          "description": "Optional buyer Gmail/contact email."
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "role": {
          "type": "string",
          "enum": ["buyer", "admin"]
        },
        "balance": {
          "type": "number",
          "description": "Available PHP wallet balance (>= 0)."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "email",
        "displayName",
        "role",
        "balance",
        "createdAt",
        "updatedAt"
      ]
    },
    "UsernameReservation": {
      "title": "Username Reservation",
      "description": "Unique lowercase username reservation preventing duplicate buyer accounts.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "username": {
          "type": "string",
          "minLength": 3,
          "maxLength": 24,
          "pattern": "^[a-z0-9_]{3,24}$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "username", "createdAt"]
    },
    "TopUpRequest": {
      "title": "GCash Manual Top-Up Request",
      "description": "Manual GCash top-up submission awaiting owner verification and balance credit.",
      "type": "object",
      "properties": {
        "requestCode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 24
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userEmail": {
          "type": "string",
          "minLength": 3,
          "maxLength": 120
        },
        "userName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "method": {
          "type": "string",
          "enum": ["GCash"]
        },
        "amountPhp": {
          "type": "number"
        },
        "referenceNo": {
          "type": "string",
          "maxLength": 60
        },
        "proofImageUrl": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160000
        },
        "status": {
          "type": "string",
          "enum": ["Pending", "Approved", "Rejected"]
        },
        "adminNote": {
          "type": "string",
          "maxLength": 240
        },
        "reviewedBy": {
          "type": "string",
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "requestCode",
        "userId",
        "userEmail",
        "userName",
        "method",
        "amountPhp",
        "referenceNo",
        "proofImageUrl",
        "status",
        "adminNote",
        "reviewedBy",
        "createdAt",
        "updatedAt"
      ]
    },
    "StoreOrder": {
      "title": "Wallet Balance Order",
      "description": "Purchase order paid using an authenticated buyer's PHP wallet balance.",
      "type": "object",
      "properties": {
        "orderCode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 24
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userEmail": {
          "type": "string",
          "minLength": 3,
          "maxLength": 120
        },
        "userName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "stockId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "stockCode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "stockTitle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "category": {
          "type": "string",
          "enum": ["CODM ACCOUNT", "CODM&MLBB FILES"]
        },
        "quantity": {
          "type": "number"
        },
        "startUnitIndex": {
          "type": "number",
          "description": "Starting deliveryVault unit index assigned to this order."
        },
        "unitPricePhp": {
          "type": "number"
        },
        "subtotalPhp": {
          "type": "number",
          "description": "Pre-voucher subtotal (unitPricePhp * quantity)."
        },
        "voucherCode": {
          "type": "string",
          "maxLength": 24,
          "description": "Applied normalized uppercase voucher code, or empty string."
        },
        "discountPhp": {
          "type": "number",
          "description": "PHP discount applied from the voucher code."
        },
        "totalPhp": {
          "type": "number"
        },
        "paymentMethod": {
          "type": "string",
          "enum": ["Wallet Balance"]
        },
        "deliveryStatus": {
          "type": "string",
          "enum": ["Processing", "Delivered", "Refunded"]
        },
        "deliveryNote": {
          "type": "string",
          "maxLength": 1000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "orderCode",
        "userId",
        "userEmail",
        "userName",
        "stockId",
        "stockCode",
        "stockTitle",
        "category",
        "quantity",
        "unitPricePhp",
        "totalPhp",
        "paymentMethod",
        "deliveryStatus",
        "deliveryNote",
        "createdAt",
        "updatedAt"
      ]
    },
