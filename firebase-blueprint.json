        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "buyerName",
        "itemLabel",
        "rating",
        "comment",
        "dealChannel",
        "proofImageUrl",
        "ownerId",
        "createdAt",
        "updatedAt"
      ]
    },
