        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "stockId", "orderId", "createdAt"]
    }
  },
  "firestore": {
    "/stocks/{stockId}": {
      "schema": { "$ref": "#/entities/StockItem" },
      "description": "Publicly readable stock listings managed by verified admins, with atomic stock decrement verified for balance orders."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private customer profile & PHP wallet balance. Users create with zero balance; only admins can increase balances."
    },
    "/usernames/{username}": {
      "schema": { "$ref": "#/entities/UsernameReservation" },
      "description": "Atomic username handle reservation mapping unique usernames to a single buyer UID."
    },
    "/topupRequests/{requestId}": {
      "schema": { "$ref": "#/entities/TopUpRequest" },
      "description": "Manual GCash top-up requests with payment proof. Buyers create Pending requests; only admins approve/reject."
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/StoreOrder" },
      "description": "Orders paid from wallet balance, verified atomically against stock price, voucher discount, and balance deduction."
    },
    "/vouchers/{voucherCode}": {
      "schema": { "$ref": "#/entities/VoucherCode" },
      "description": "Owner-created promo voucher codes. Listing is admin-only; buyers may get single typed codes and atomically increment usedCount on checkout."
    },
    "/deliveryVault/{stockId}": {
      "schema": { "$ref": "#/entities/DeliveryVaultItem" },
      "description": "Private auto-delivery secrets (credentials or file links) readable only by admins or buyers holding /entitlements/{uid}_{stockId}."
    },
    "/entitlements/{entitlementId}": {
      "schema": { "$ref": "#/entities/DeliveryEntitlement" },
      "description": "Purchase entitlements created atomically alongside paid orders to unlock auto-delivery items."
    },
    "/inquiries/{inquiryId}": {
      "schema": { "$ref": "#/entities/CustomerInquiry" },
      "description": "Customer inquiry dropbox: visitors create inquiries; reads, status updates, and deletes restricted to verified admins."
    },
    "/reviews/{reviewId}": {
      "schema": { "$ref": "#/entities/ReviewItem" },
      "description": "Publicly readable buyer reviews and deal proofs managed exclusively by verified store admins."
    },
    "/socialLinks/{linkId}": {
      "schema": { "$ref": "#/entities/SocialLink" },
      "description": "Publicly readable seller social contact links managed exclusively by verified store admins."
    },
    "/storeSettings/{settingId}": {
      "schema": { "$ref": "#/entities/StoreSettings" },
      "description": "Publicly readable storefront copy, GCash payment details, and guidelines managed by verified admins."
    },
    "/admins/{userId}": {
      "schema": { "$ref": "#/entities/AdminUser" },
      "description": "Restricted collection of authorized store admin UIDs."
    }
  }
}
